<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.plutotv" name="Pluto TV" version="2.2.0" provider-name="ZorinTV Pluto">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="inputstream.adaptive" version="2.0.0"/>
    <import addon="repository.slyguy" version="0.0.9"/>
    <import addon="slyguy.pluto.tv.provider" version="0.7.8" optional="true"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="pt_BR">Canais Pluto TV</summary>
    <description lang="pt_BR">Addon para assistir aos canais da Pluto TV organizados por categoria.</description>
    <platform>all</platform>
    <license>All Rights Reserved</license>
    <assets>
      <icon>resources/media/icon.png</icon>
      <fanart>resources/media/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
<addon id="plugin.video.runtimezorintv"
       name="ZorinTV"
       version="1.0.1"
       provider-name="ZorinTV">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="pt_BR">ZorinTV - Canais de TV ao vivo</summary>
        <description lang="pt_BR">ZorinTV com canais de TV ao vivo: Ação, Comédia, Romance, Família, Cine Espanto, Crime, Record News e mais.</description>
        <platform>all</platform>
        <license>All Rights Reserved</license>
        <assets>
            <icon>runtime.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.runtimekodi" name="RuntimeKodi Repository" version="1.0.0" provider-name="zorintv">
  <extension point="xbmc.addon.repository">
    <info>
      <checksum>https://zorintv.github.io/RuntimeKodi/addons.xml.md5</checksum>
      <datadir zip="true">https://zorintv.github.io/RuntimeKodi/zips/</datadir>
    </info>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Repositório RuntimeKodi</summary>
    <description>Repositório com addons para Kodi - RuntimeZintv e PlutoTV</description>
    <platform>all</platform>
  </extension>
</addon>
<addon id="repository.slyguy" name="SlyGuy Repository" provider-name="SlyGuy" version="0.0.9">
  <extension point="xbmc.addon.repository" name="SlyGuy Repository">
    <dir>
      <info compressed="false">https://slyguy.uk/.repo/repository.slyguy/addons.xml</info>
      <checksum>https://slyguy.uk/.repo/repository.slyguy/addons.xml.md5</checksum>
      <datadir zip="true">https://slyguy.uk/.repo/repository.slyguy/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <description lang="en">Addons by SlyGuy (slyguy.uk)</description>
    <license></license>
    <language></language>
    <website></website>
    <news></news>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
</addons>
